<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PagosController">
  <top><HBox spacing="10"><padding><Insets top="10" right="10" bottom="10" left="10"/></padding><Label text="Registro de pagos"/><Button text="Inicio" onAction="#volver"/></HBox></top>
  <center><TableView fx:id="tabla" onMouseClicked="#cargar"><columns><TableColumn fx:id="codigoCol" text="Código"/><TableColumn fx:id="fechaCol" text="Fecha"/><TableColumn fx:id="inscripcionCol" text="Inscripción"/><TableColumn fx:id="metodoCol" text="Método"/><TableColumn fx:id="montoCol" text="Monto pagado"/></columns></TableView></center>
  <bottom><VBox spacing="8"><padding><Insets top="10" right="10" bottom="10" left="10"/></padding><HBox spacing="8"><TextField fx:id="codigoField" promptText="Código de pago"/><DatePicker fx:id="fechaPicker"/><ComboBox fx:id="inscripcionCombo" promptText="Inscripción"/><ComboBox fx:id="metodoCombo" promptText="Método"/><TextField fx:id="montoField" promptText="Monto pagado"/></HBox><HBox spacing="8"><Button text="Guardar / actualizar" onAction="#guardar"/><Button text="Eliminar" onAction="#eliminar"/><Button text="Limpiar" onAction="#limpiar"/></HBox></VBox></bottom>
</BorderPane>
