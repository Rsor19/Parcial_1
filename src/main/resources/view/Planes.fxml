<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.PlanesController" spacing="10">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Planes del gimnasio" />
    <HBox spacing="8">
        <TextField fx:id="idField" promptText="Identificador" />
        <ComboBox fx:id="tipoCombo" promptText="Tipo de plan" />
        <Button text="Agregar" onAction="#agregarPlan" />
        <Button text="Actualizar" onAction="#actualizarPlan" />
        <Button text="Limpiar" onAction="#limpiarFormulario" />
    </HBox>
    <TableView fx:id="planesTable" onMouseClicked="#cargarSeleccion" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="120" />
            <TableColumn fx:id="tipoColumn" text="Tipo" prefWidth="130" />
            <TableColumn fx:id="precioColumn" text="Precio base" prefWidth="120" />
            <TableColumn fx:id="precioFinalColumn" text="Precio final" prefWidth="120" />
            <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="120" />
        </columns>
    </TableView>
    <HBox spacing="8">
        <Button text="Activar / desactivar" onAction="#cambiarEstado" />
        <Button text="Eliminar" onAction="#eliminarPlan" />
        <Button text="Inicio" onAction="#volverInicio" />
    </HBox>
</VBox>
